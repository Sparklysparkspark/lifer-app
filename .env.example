# Postgres connection string
DATABASE_URL=postgres://lifer:lifer@localhost:5432/lifer

# Port to listen on
PORT=4000

# Host path for your photo library (bind-mounted into the container as /data)
LIFER_STORAGE_DIR=./data/lifer

# User and group Lifer runs as in Docker (never root). The permissions service gives the library
# and app-data folders to this user on start. 568 is TrueNAS's "apps" user; `id` shows your own.
PUID=568
PGID=568

# Extra folders Lifer may use besides the library above (reimport, trips, uploads to another
# disk). Comma-separated "Label=/container/path" entries; mount each one in docker-compose.yml,
# e.g. "- /srv/nas/photos:/library/nas" with LIFER_LIBRARY_ROOTS=NAS=/library/nas
LIFER_LIBRARY_ROOTS=

# If the server stops responding for this many seconds it logs what it was doing and restarts
# itself (needs the compose file's "restart: unless-stopped"). 0 keeps only the log warning.
LIFER_FREEZE_RESTART_SECONDS=120

# Largest single file you can upload, in bytes. 0 (the default) means no cap: uploads stream to
# disk, so size only matters for free disk space.
MAX_UPLOAD_BYTES=0

# Largest photo, in pixels, Lifer will open (a guard against decompression bombs). Default
# 2000000000 (2 gigapixels); 0 means no limit.
LIFER_MAX_IMAGE_PIXELS=

# Where uploads wait until they're imported. Empty (the default) picks a folder next to the
# library, on its own drive, so filing an upload into the library is a quick rename. In Docker
# this is a container path, e.g. one under /data.
LIFER_UPLOAD_WORK_DIR=

# Largest ordinary (JSON) request body, in bytes. Default 64 MB. Uploads don't count toward it.
LIFER_MAX_JSON_BODY_BYTES=

# Reverse proxies Lifer trusts for the visitor's real IP and HTTPS. Empty (the default) trusts
# proxies on this machine or a private network. Set a hop count like 2 for Cloudflare in front of
# your own proxy, or true, false, or a comma-separated list of IPs or ranges.
TRUST_PROXY=

# Species matching uses a passed-in GPU on its own when it's faster. "off" keeps it on the CPU,
# for troubleshooting only.
LIFER_GPU=
