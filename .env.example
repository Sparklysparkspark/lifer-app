# Postgres connection string
DATABASE_URL=postgres://lifer:lifer@localhost:5432/lifer

# Port to listen on
PORT=4000

# Host path for your photo library (bind-mounted into the container as /data)
LIFER_STORAGE_DIR=./data/lifer

# SMTP settings for password-reset emails (optional — logs the reset link instead if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lifer <no-reply@lifer.app>

# Public URL of this instance, used in password-reset emails (use your LAN IP or domain, not localhost)
APP_URL=http://192.168.1.50:4000
