# Postgres connection string
DATABASE_URL=postgres://lifer:lifer@localhost:5432/lifer

# Port to listen on
PORT=4000

# Host path for your photo library (bind-mounted into the container as /data)
LIFER_STORAGE_DIR=./data/lifer

# SMTP settings for password-reset emails (optional — logs the reset link instead if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lifer <no-reply@lifer.app>

# Public URL of this instance, used in password-reset emails (use your LAN IP or domain, not localhost)
APP_URL=http://192.168.1.50:4000

# The session cookie is marked Secure (HTTPS-only) automatically when APP_URL starts with
# https:// — a browser silently refuses to store a Secure cookie over plain HTTP, so this is
# what actually determines whether login persists a session, not just cosmetic. Only set this
# explicitly (1 or 0) if you're running a reverse proxy that terminates TLS upstream and forwards
# to Lifer over plain HTTP internally, where APP_URL is (correctly) still the public https://
# address — in that one case, set COOKIE_SECURE=1 here since the URL alone can't tell.
COOKIE_SECURE=
