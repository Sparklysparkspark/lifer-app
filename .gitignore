# Dependencies and build output
node_modules/
dist/
coverage/
*.log

# Local configuration and OS files
.env
.DS_Store
docker-compose.override.yml

# Python tooling (model export and pipeline helpers)
.venv/
__pycache__/

# Local app data, backups and script reports: never commit
/data/
/archive/
/packs/
packages/data-pipeline/packs/
.cache/

# Data pipeline builds and download caches (several GB). The few caches that are committed on
# purpose are tracked explicitly and unaffected by these patterns.
packages/data-pipeline/data/build/
packages/data-pipeline/data/*-cache/
packages/data-pipeline/data/inat-current-taxon-cache.json
packages/data-pipeline/data/inat-taxa-cache.json
packages/data-pipeline/data/inat-taxon-status-cache.json
packages/data-pipeline/data/open-vectors/
packages/data-pipeline/data/backups/
# Applied-run records the fix scripts write next to the reviewed list; the reviewed list is tracked.
packages/data-pipeline/data/review/*-applied-*.tsv

# Docs site (Docusaurus)
docs/node_modules/
docs/build/
docs/.docusaurus/

# Playwright end-to-end test output (npm run test:e2e)
test-results/
/screens/
# Visual baselines are made on macOS and stay local (CI renders on Linux).
e2e/visual/__screenshots__/
playwright-report/
blob-report/

# Mutation testing (npm run test:mutation): Stryker's sandboxes and reports
.stryker-tmp/
reports/mutation/

# Expo prebuild output (generated by expo run:ios and run:android)
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
!apps/mobile/modules/**/ios/
!apps/mobile/modules/**/android/

# Full-size before and after screenshots behind the plans; too large for the repo.
docs/plans/assets/
