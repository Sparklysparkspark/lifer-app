{
  "name": "api",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit && vitest run --project timing",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html",
    "lifer-admin": "tsx src/admin/liferAdmin.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@lifer/core": "*",
    "@lifer/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "dotenv": "^18.0.10",
    "exiftool-vendored": "^39.4.0",
    "fastify": "^5.12.6",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "jxl-oxide-wasm": "^0.12.6",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.23",
    "typebox": "^1.4.7",
    "undici": "^6.29.1"
