    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@huggingface/transformers": "^4.3.0",
    "@lifer/core": "*",
    "@lifer/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^37.2.0",
    "fastify": "^5.12.5",
