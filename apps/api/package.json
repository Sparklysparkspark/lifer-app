    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^5.1.1",
    "data-pipeline": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
