{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifer",
  "version": "0.1.0",
  "identifier": "app.lifer.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources-staging/api": "api",
      "resources-staging/web": "web",
      "resources-staging/node_modules": "node_modules"
    },
    "macOS": {
      "entitlements": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
