{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Lifer desktop app",
  "author": "Lifer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build -w web && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.lifer.desktop",
    "productName": "Lifer",
    "artifactName": "Lifer-${version}-${arch}.${ext}",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "afterPack": "afterPack.js",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/src",
        "to": "api/src"
      },
      {
        "from": "../api/package.json",
        "to": "api/package.json"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/shared",
        "to": "packages/shared",
        "filter": [
          "src/**/*",
          "package.json"
        ]
      },
      {
        "from": "../../packages/data-pipeline",
        "to": "packages/data-pipeline",
        "filter": [
          "src/**/*",
          "migrations/**/*",
          "package.json"
