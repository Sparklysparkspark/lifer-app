{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-server",
  "description": "Limited access for a connected remote server's pages: no shell, fs writes only to paths the user picked in a save dialog",
  "windows": ["main"],
  "local": false,
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-app-commands",
    "opener:default",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "updater:default",
    "process:default"
  ],
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  }
}
