{
  "name": "mobile",
  "version": "0.11.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "check:ui": "node scripts/check-ui.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:android": "node scripts/check-android-deps.mjs"
  },
  "dependencies": {
    "@lifer/shared": "*",
    "@noble/hashes": "^2.4.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "i18next": "^26.4.3",
    "i18next-icu": "^2.5.0",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|intl-messageformat|@formatjs/.*|i18next-icu|tslib|@noble/.*))"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ]
  }
}
