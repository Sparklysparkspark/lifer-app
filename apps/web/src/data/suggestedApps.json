[
  {
    "id": "app.preen.desktop",
    "name": "Preen",
    "label": "Cull",
    "description": "A separate app that culls a memory card fast and sends the keepers into Lifer.",
    "publisher": "the maker of Lifer",
    "homepage": "https://preenwildlife.com",
    "offer": "cull",
    "scopes": ["userdata.read", "userdata.write", "imports.write", "opendata.read", "host.preference"],
    "icon": "M4 5h16v14H4zM8 9h8v6H8z",
    "iconSrc": "/branding/preen.png",
    "iconSrcDark": "/branding/preen-dark.png",
    "install": {
      "feed": "https://updates.preenwildlife.com/{channel}/latest.json",
      "channel": "stable",
      "hosts": ["updates.preenwildlife.com", "dl.preenwildlife.com"],
      "minisignKeys": ["PLACEHOLDER"],
      "pending": true,
      "platforms": {
        "darwin-aarch64": {
          "format": "dmg",
          "signer": "PLACEHOLDER"
        },
        "darwin-x86_64": {
          "format": "dmg",
          "signer": "PLACEHOLDER"
        },
        "windows-x86_64": {
          "format": "nsis",
          "signer": "PLACEHOLDER"
        },
        "linux-x86_64": {
          "format": "deb"
        }
      },
      "locations": {
        "darwin": [
          "/Applications/Preen.app/Contents/MacOS/preen-shell",
          "~/Applications/Preen.app/Contents/MacOS/preen-shell"
        ],
        "win32": ["%LOCALAPPDATA%/Preen/preen-shell.exe", "%LOCALAPPDATA%/Programs/Preen/preen-shell.exe"],
        "linux": ["/usr/bin/preen-shell"]
      }
    }
  }
]
