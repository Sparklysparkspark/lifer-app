{
  "name": "@lifer/core",
  "version": "0.10.2",
  "description": "Code shared by the Lifer server and the data pipeline: configuration, the database pool, species enrichment and matching, region computation and GBIF helpers.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lifer/shared": "*",
    "dotenv": "^18.0.6",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.3",
    "fastify": "^5.12.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
