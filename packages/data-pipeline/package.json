{
  "name": "data-pipeline",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "refresh": "tsx src/scripts/refresh.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "build-seed": "tsx src/build/build-seed.ts",
    "build-seed-test": "tsx src/build/build-seed-test.ts",
    "build-seed-mammals": "tsx src/build/build-seed-mammals.ts",
    "build-seed-fish": "tsx src/build/build-seed-fish.ts",
    "build-seed-amphibians": "tsx src/build/build-seed-amphibians.ts",
    "build-seed-squamata": "tsx src/build/build-seed-squamata.ts",
    "build-seed-testudines": "tsx src/build/build-seed-testudines.ts",
    "build-seed-corals": "tsx src/build/build-seed-corals.ts",
    "build-seed-jellies-anemones": "tsx src/build/build-seed-jellies-anemones.ts",
    "build-seed-sponges-tunicates": "tsx src/build/build-seed-sponges-tunicates.ts",
    "build-seed-echinoderms": "tsx src/build/build-seed-echinoderms.ts",
    "build-seed-crustaceans": "tsx src/build/build-seed-crustaceans.ts",
    "build-seed-marine-mollusks": "tsx src/build/build-seed-marine-mollusks.ts",
    "build-seed-cephalopods": "tsx src/build/build-seed-cephalopods.ts",
    "build-seed-nudibranchs": "tsx src/build/build-seed-nudibranchs.ts",
    "load-seed": "tsx src/build/load-seed.ts",
    "compute-elusiveness": "tsx src/build/compute-elusiveness.ts",
    "build-region-pack": "tsx src/build/build-region-pack.ts",
    "replace-sea-zones": "tsx src/scripts/replace-sea-zones.ts",
    "build-pack-index": "tsx src/build/build-pack-index.ts",
    "backup": "tsx src/scripts/backup.ts",
    "apply-photo-licenses": "tsx src/scripts/apply-photo-licenses.ts",
    "backfill-photo-withheld": "tsx src/scripts/backfill-photo-withheld.ts",
    "backfill-descriptions": "tsx src/scripts/backfill-descriptions.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html",
    "enrich-all-species": "tsx src/scripts/enrich-all-species.ts"
  },
  "dependencies": {
    "@lifer/core": "*",
    "@lifer/shared": "*",
    "dotenv": "^18.0.6",
    "duckdb": "^1.4.4",
    "exceljs": "^4.4.0",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
