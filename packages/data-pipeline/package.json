{
  "name": "data-pipeline",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "refresh": "tsx src/scripts/refresh.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "build-seed": "tsx src/build/build-seed.ts",
    "build-seed-test": "tsx src/build/build-seed-test.ts",
    "build-seed-mammals": "tsx src/build/build-seed-mammals.ts",
    "build-seed-fish": "tsx src/build/build-seed-fish.ts",
    "build-seed-amphibians": "tsx src/build/build-seed.ts --group=amphibians",
    "build-seed-squamata": "tsx src/build/build-seed.ts --group=squamata",
    "build-seed-testudines": "tsx src/build/build-seed.ts --group=testudines",
    "build-seed-corals": "tsx src/build/build-seed.ts --group=corals",
    "build-seed-jellies-anemones": "tsx src/build/build-seed.ts --group=jellies-anemones",
    "build-seed-sponges-tunicates": "tsx src/build/build-seed.ts --group=sponges-tunicates",
    "build-seed-echinoderms": "tsx src/build/build-seed.ts --group=echinoderms",
    "build-seed-crustaceans": "tsx src/build/build-seed.ts --group=crustaceans",
    "build-seed-marine-mollusks": "tsx src/build/build-seed-marine-mollusks.ts",
    "build-seed-cephalopods": "tsx src/build/build-seed.ts --group=cephalopods",
    "build-seed-nudibranchs": "tsx src/build/build-seed.ts --group=nudibranchs",
    "load-seed": "tsx src/build/load-seed.ts",
    "build-region-pack": "tsx src/build/build-region-pack.ts",
    "replace-sea-zones": "tsx src/scripts/replace-sea-zones.ts",
    "build-sea-zones-marine": "tsx src/scripts/build-sea-zones-marine.ts",
    "build-pack-index": "tsx src/build/build-pack-index.ts",
    "backup": "tsx src/scripts/backup.ts",
    "apply-photo-licenses": "tsx src/scripts/apply-photo-licenses.ts",
    "backfill-photo-withheld": "tsx src/scripts/backfill-photo-withheld.ts",
    "backfill-descriptions": "tsx src/scripts/backfill-descriptions.ts",
    "load-species-notes": "tsx src/scripts/load-species-notes.ts",
    "fix-catalog-audit": "tsx src/scripts/fix-catalog-audit.ts",
    "apply-inat-membership": "tsx src/scripts/apply-inat-membership.ts",
    "apply-inat-common-names": "tsx src/scripts/apply-inat-common-names.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html",
    "enrich-all-species": "tsx src/scripts/enrich-all-species.ts",
    "open-vectors": "tsx src/scripts/open-vectors.ts",
    "top-up-galleries": "tsx src/scripts/top-up-galleries.ts",
    "benchmark-matching": "tsx src/scripts/benchmark-matching.ts"
  },
  "dependencies": {
    "@lifer/core": "*",
    "@lifer/shared": "*",
    "dotenv": "^18.0.10",
    "duckdb": "^1.4.4",
    "exceljs": "^4.4.0",
    "onnxruntime-node": "^1.29.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
